{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "digital-dukaan",
  "version": "0.1.0",
  "identifier": "Digital-Dukaan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DIGITAL DUKAAN",
        "width": 1250,
        "height": 950,
        "minWidth": 1250,
        "minHeight": 900,
        "visible": false,
        "center": true,
        "backgroundColor": "#f4f7f8"
      },
      {
        "label": "splashscreen",
        "title": "Digital Dukaan",
        "width": 500,
        "height": 400,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "url": "/splashscreen.html",
        "backgroundColor": "#f4f7f8"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}